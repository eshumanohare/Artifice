{
  "name": "artifice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "stream": "python3 scripts/stream_orders.py",
    "stream:pm2": "pm2 start ecosystem.config.js",
    "stream:stop": "pm2 stop artifice-stream",
    "stream:restart": "pm2 restart artifice-stream",
    "stream:logs": "pm2 logs artifice-stream",
    "stream:status": "pm2 status",
    "docker:build": "docker build -t artifice-stream .",
    "docker:run": "docker run -d --name artifice-stream -v $(pwd)/cache:/app/.cache artifice-stream",
    "docker:stop": "docker stop artifice-stream && docker rm artifice-stream",
    "docker:compose": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "setup": "pip3 install -r requirements.txt && npm install",
    "deploy:vercel": "vercel --prod",
    "deploy:vercel:preview": "vercel",
    "vercel:logs": "vercel logs",
    "vercel:status": "vercel ls",
    "test:cron": "curl -H 'Authorization: Bearer $CRON_SECRET' $VERCEL_URL/api/fetch_orders",
    "deploy:railway": "railway up"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "next": "15.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
